// DOI Monitor — TiDB Serverless (MySQL 8 compatible)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Snapshot stok terkini dari OCS (/odata/DTO_WmsItemStockLiteV2).
/// Ditimpa tiap sinkronisasi; baris yang hilang dari sumber ikut dihapus.
model StockCurrent {
  sku          String   @db.VarChar(120)
  areaId       String   @db.VarChar(60)
  name         String   @default("") @db.VarChar(500)
  sapCode      String?  @db.VarChar(60)
  category     String?  @db.VarChar(40)
  qtyRack      Int      @default(0)
  qtyBulk      Int      @default(0)
  qtyOnHand    Int      @default(0)
  qtyOnOrder   Int      @default(0)
  availableQty Int      @default(0)
  reserveQty   Int      @default(0)
  isActive     Boolean  @default(true)
  firstSeenAt  DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@id([sku, areaId])
  @@index([category, isActive])
  @@map("stock_current")
}

/// Riwayat stok harian (satu baris per SKU per area per hari), ditulis saat
/// perhitungan 07.30. Dipakai untuk mengeluarkan hari stok kosong dari ADS
/// dan untuk tren. Tidak pernah ditimpa oleh Refresh selain hari yang sama.
model StockDaily {
  snapshotDate DateTime @db.Date
  sku          String   @db.VarChar(120)
  areaId       String   @db.VarChar(60)
  availableQty Int      @default(0)
  qtyOnHand    Int      @default(0)
  qtyOnOrder   Int      @default(0)

  @@id([snapshotDate, sku, areaId])
  @@index([sku, snapshotDate])
  @@map("stock_daily")
}

/// Penjualan harian per SKU per area. Kunci unik (tanggal, sku, area)
/// membuat sinkronisasi harian idempoten — menarik ulang hari yang sama aman.
model SalesDaily {
  id         BigInt   @id @default(autoincrement())
  salesDate  DateTime @db.Date
  sku        String   @db.VarChar(120)
  areaId     String   @db.VarChar(60)
  qty        Int      @default(0)
  /** Qty dari order yang TIDAK memakan stok: NA, UNPAID, IN_CANCEL, CANCELLED. */
  qtyCancel  Int      @default(0)
  qtyShopee  Int      @default(0)
  qtyTiktok  Int      @default(0)
  qtyTokped  Int      @default(0)
  qtyLazada  Int      @default(0)
  qtyOther   Int      @default(0)
  source     String   @default("sync") @db.VarChar(16) // sync | upload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([salesDate, sku, areaId], name: "sales_daily_key")
  @@index([sku, salesDate])
  @@index([salesDate])
  @@map("sales_daily")
}

/// Stok dalam perjalanan — satu angka per SKU. Unggahan bersifat REPLACE:
/// seluruh isi tabel diganti dengan isi berkas terakhir.
/// Catatan bahwa satu pasangan (tanggal, area) PERNAH ditarik — termasuk
/// ketika hasilnya nol baris.
///
/// Tanpa tabel ini, "tidak ada baris" dan "belum pernah ditarik" tidak bisa
/// dibedakan. Akibatnya nyata: cabang Medan & Makassar memang belum berjualan
/// di awal Juni, hasilnya 0 baris, dan `--verify` melaporkannya sebagai 30
/// lubang yang tidak pernah bisa ditambal — sementara `--resume` menarik ulang
/// hari-hari itu setiap kali dijalankan, selamanya.
model SalesPull {
  salesDate DateTime @db.Date
  areaId    String   @db.VarChar(60)
  /// Jumlah baris hasil penarikan. BUKAN bernama `rows`: itu kata cadangan di
  /// MySQL 8 / TiDB (fungsi window), dan query-nya gagal dengan error 1064.
  rowCount  Int      @default(0)
  pulledAt  DateTime @default(now())

  @@id([salesDate, areaId])
  @@map("sales_pull")
}

/// Barang dalam perjalanan (SIT), satu baris per SKU per gudang tujuan.
///
/// Kuncinya (sku, areaId) — bukan sku saja. Barang yang menuju Surabaya adalah
/// stok Surabaya, bukan stok perusahaan tanpa alamat; tanpa areaId, transit ke
/// lima kota saling menimpa dan DOI per area mustahil dibuat.
model TransitStock {
  sku        String    @db.VarChar(120)
  areaId     String    @default("Pusat") @db.VarChar(60)
  qty        Int       @default(0)
  eta        DateTime? @db.Date
  note       String?   @db.VarChar(300)
  batchId    String?   @db.VarChar(40)
  /// ocs = ditarik dari /api/receive-stock dan ditimpa tiap sinkronisasi.
  /// manual = diunggah orang, tidak pernah disentuh sinkronisasi.
  source     String    @default("manual") @db.VarChar(10)
  /// Nomor DO OCS, untuk menelusuri baris ini kembali ke dokumennya.
  docNums    String?   @db.VarChar(300)
  /// Jumlah versi BatchQuantity — disimpan sebagai pembanding, tidak dipakai DOI.
  qtyBatch   Int       @default(0)
  updatedAt  DateTime  @default(now()) @updatedAt

  @@id([sku, areaId])
  @@index([areaId, source])
  @@map("transit_stock")
}

/// Cache baris satu dokumen Receive OCS.
///
/// Satu dokumen butuh ±5,5 dtk untuk ditarik, dan ada ±20 dokumen — total ±110
/// dtk, jauh di atas batas 60 dtk satu fungsi Vercel. Tanpa cache, tombol
/// Refresh selalu berhenti di tengah: dokumen yang tersisa tidak pernah terbaca,
/// pembersihan dilewati terus, dan setiap klik memulai dari dokumen pertama lagi
/// sehingga tidak pernah maju.
///
/// Dengan cache, klik pertama mengisi sebagian, klik berikutnya hanya menarik
/// dokumen yang belum ada, dan sesudah itu sinkronisasi selesai dalam hitungan
/// detik. Isi dokumen Receive praktis tidak berubah setelah dibuat, jadi yang
/// penting hanya mendeteksi dokumen BARU — dan itu datang dari daftar dokumen
/// yang selalu ditarik ulang.
model ReceiveDoc {
  docNum    Int      @id
  /// Baris mentah apa adanya dari OCS, JSON.
  lines     String   @db.LongText
  lineCount Int      @default(0)
  pulledAt  DateTime @default(now())

  @@index([pulledAt])
  @@map("receive_doc")
}

/// Isi satu karton per SKU. Dipakai HANYA untuk menampilkan "39 ctn 32 pcs";
/// total pcs selalu datang dari DoQty, tidak pernah dari perkalian ini.
///
/// `fromOcs` = PerCtnQty dari OCS (sering 0), `fromName` = angka setelah " x "
/// di akhir nama produk. `manual` menang atas keduanya kalau diisi.
model SkuBox {
  sku       String   @id @db.VarChar(120)
  perCtn    Int      @default(0)
  fromOcs   Int      @default(0)
  fromName  Int      @default(0)
  manual    Int?
  /// true bila fromOcs dan fromName sama-sama ada tapi BERBEDA — tanda master
  /// OCS atau penamaan produknya perlu dibetulkan.
  mismatch  Boolean  @default(false)
  name      String   @default("") @db.VarChar(500)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("sku_box")
}

/// Master per SKU: lead time kirim (hari) dan penanda dikecualikan.
/// SKU tanpa baris di sini memakai default global dari Pengaturan.
/// Produk yang masuk masa phase out: masih dijual sampai habis, tidak di-PO lagi.
/// Dicocokkan lewat kode SAP (6 digit terakhir) atau lewat SKU langsung.
model PhaseOut {
  key            String    @id @db.VarChar(140)
  matchType      String    @default("SAP") @db.VarChar(3)
  matchValue     String    @db.VarChar(120)
  sapCode        String?   @db.VarChar(60)
  effectiveDate  DateTime? @db.Date
  reason         String?   @db.VarChar(120)
  replacementSku String?   @db.VarChar(120)
  targetOutDate  DateTime? @db.Date
  disposition    String    @default("SELL_DOWN") @db.VarChar(20)
  note           String?   @db.VarChar(300)
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([matchType, matchValue])
  @@map("phase_out")
}

/// Cabang / gudang yang dipantau. DIISI DARI PENGATURAN, bukan dari kode:
/// menambah cabang baru tidak boleh perlu deploy.
///
/// `code` = kode gudang OCS - `AddressCode` di receive-stock, `AreaId` di stok.
/// `name` = nama area yang dipakai di SELURUH aplikasi (stock_current.areaId,
/// sales_daily.areaId, transit_stock.areaId, doi_summary.areaId).
///
/// PERINGATAN: gudang pemasok EJI di web.eji.co.id/sap_whs/stock kebetulan juga
/// bernama "GBJD", dan itu BUKAN area ini. Tabel ini hanya untuk gudang IEG.
/// Saldo pemasok tinggal di tabel sendiri dengan kolom `supplierWhs`.
model Area {
  code      String    @id @db.VarChar(20)
  name      String    @db.VarChar(60)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(100)
  /// Batas atas pita KRITIS (hari). DOI <= ini -> CRITICAL.
  ///
  /// Tiga kolom di bawah ini menyimpan EMPAT pita stok dengan TIGA angka, dan itu
  /// disengaja: dengan tiga batas, celah dan tumpang-tindih antar pita mustahil
  /// terjadi. Menyimpan batas bawah DAN atas setiap pita (6-8 angka) membuka
  /// kemungkinan "kritis <=13, low mulai 15" — hari ke-14 tidak masuk pita mana
  /// pun, dan SKU di hari itu hilang dari semua laporan tanpa jejak.
  ///
  /// Semuanya MUTLAK dalam hari, bukan tambahan di atas lead time:
  ///   DOI <= doiCritical           -> CRITICAL
  ///   DOI <= doiMin                -> LOW         (masuk Sugest PO)
  ///   DOI <= doiMax                -> HEALTHY
  ///   DOI >  doiMax                -> OVERSTOCK
  /// Harus naik: doiCritical < doiMin <= doiMax. Kosong = pakai pengaturan global.
  doiCritical Int?
  /// Batas atas pita LOW (hari) = titik pesan. DOI <= ini masuk Sugest PO.
  doiMin    Int?
  /// Batas atas pita AMAN (hari) = tingkat isi-ulang DAN ambang overstock.
  doiMax    Int?
  /// Tanggal mulai operasional - menggantikan pengaturan `sales_area_start`.
  startDate DateTime? @db.Date
  note      String?   @db.VarChar(300)
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([isActive, sortOrder])
  @@map("area")
}

/// Satu produk, beberapa kode. Menggantikan pencocokan "6 digit terakhir sama".
///
/// Dulu hubungan antar wadah bisa disimpulkan dari bentuk kodenya: wadah IEG
/// berprefiks 1222/122, wadah EJI 1201/120, dan 6 digit terakhirnya sama. Dua
/// hal membatalkan itu: satu produk bisa punya LEBIH DARI dua kode, dan ada
/// produk yang 6 digit terakhirnya sudah tidak sama antar wadah. Jadi
/// hubungannya dipetakan, bukan diterka.
///
/// `groupKey` mengikat semuanya. `priority` menentukan kode mana diambil lebih
/// dulu saat Sugest PO (122 dulu, lalu 120, hanyalah priority 1 dan 2).
/// `perCtn` per kode karena isi kartonnya memang sering berbeda.
model SkuLink {
  id        Int      @id @default(autoincrement())
  groupKey  String   @db.VarChar(120)
  /// OCS | SAP
  system    String   @db.VarChar(8)
  code      String   @db.VarChar(60)
  /// Kecil = diambil lebih dulu saat Sugest PO.
  priority  Int      @default(9)
  /// Isi satu karton untuk kode INI (pcs). 0/null = belum diketahui.
  perCtn    Int?
  note      String?  @db.VarChar(300)
  updatedAt DateTime @default(now()) @updatedAt

  /// Satu kode hanya boleh milik satu produk - kalau tidak, saldo gudang bisa
  /// dijanjikan ke dua produk sekaligus.
  @@unique([system, code], name: "sku_link_code")
  @@index([groupKey])
  @@map("sku_link")
}

/// Saldo stok di gudang PEMASOK (EJI), sumber barang untuk Sugest PO.
///
/// Dibaca dari https://web.eji.co.id/sap_whs/stock lewat endpoint DataTables
/// `GET /dt/report_iv_stok`. Kolom yang dipakai Sugest PO adalah `bal`
/// = "BALANCE ( WITH SQ )" - sudah memperhitungkan SQ terbuka.
///
/// PERINGATAN: `supplierWhs` di sini adalah gudang EJI, dan nilainya kebetulan
/// juga "GBJD". Itu BUKAN area Pusat IEG di tabel `area`. Dua dunia berbeda yang
/// bernama sama; jangan pernah dibandingkan atau di-join satu sama lain.
model SupplierStock {
  supplierWhs String   @db.VarChar(20)
  sapCode     String   @db.VarChar(60)
  name        String   @default("") @db.VarChar(500)
  /// ON HAND
  onHand      Int      @default(0)
  /// COMMITED
  committed   Int      @default(0)
  /// SQ (OPEN)
  sqOpen      Int      @default(0)
  /// ORDER
  ordered     Int      @default(0)
  /// BALANCE ( NO SQ )
  balNoSq     Int      @default(0)
  /// BALANCE ( WITH SQ ) - INI yang dipakai Sugest PO.
  bal         Int      @default(0)
  /// Isi karton dari nama produk ("… 20ml X 100" → 100). 0 = tidak terbaca.
  perCtn      Int      @default(0)
  pulledAt    DateTime @default(now())

  @@id([supplierWhs, sapCode])
  @@index([sapCode])
  @@map("supplier_stock")
}

model SkuMaster {
  sku          String   @id @db.VarChar(120)
  leadTimeDays Int?
  isExcluded   Boolean  @default(false)
  note         String?  @db.VarChar(300)
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("sku_master")
}

/// Tanggal tambahan yang dikecualikan dari ADS Opsi 1 (di luar aturan
/// payday & double date yang dihasilkan otomatis dari Pengaturan).
model ExclusionDate {
  date      DateTime @id @db.Date
  reason    String   @default("") @db.VarChar(120)
  createdAt DateTime @default(now())

  @@map("exclusion_date")
}

/// Hasil perhitungan DOI per SKU per hari. Baris hari ini ditimpa oleh Refresh.
model DoiSnapshot {
  snapshotDate   DateTime @db.Date
  /// Area yang dihitung. `GABUNGAN` = seluruh kota dijumlahkan jadi satu angka.
  areaId         String   @default("Pusat") @db.VarChar(60)
  sku            String   @db.VarChar(120)
  name           String   @default("") @db.VarChar(500)
  sapCode        String?  @db.VarChar(60)
  availableQty   Int      @default(0)
  qtyOnHand      Int      @default(0)
  qtyOnOrder     Int      @default(0)
  transitQty     Int      @default(0)
  leadTimeDays   Int      @default(0)
  firstSalesDate DateTime? @db.Date
  ageDays        Int?
  isNpl          Boolean  @default(false)
  nplNote        String?  @db.VarChar(80)
  sales90        Int      @default(0)
  salesEx        Int      @default(0)
  daysEx         Int      @default(0)
  ads1           Float    @default(0)
  ads8w          Float    @default(0)
  ads4w          Float    @default(0)
  ads2w          Float    @default(0)
  ads2           Float    @default(0)
  ads2Source     String   @default("") @db.VarChar(8)
  doi1           Float?
  doi2           Float?
  doi1Transit    Float?
  doi2Transit    Float?
  refDoi         Float?
  refDoiTransit  Float?
  status         String   @default("") @db.VarChar(20)
  action         String   @default("") @db.VarChar(60)
  suggested1     Int      @default(0)
  suggested2     Int      @default(0)
  abcClass       String   @default("C") @db.VarChar(1)
  abcShare       Float    @default(0)
  abcCumShare    Float    @default(0)
  runOutDate     DateTime? @db.Date
  isPhaseOut        Boolean   @default(false)
  phaseOutTargetDate DateTime? @db.Date
  phaseOutExcessQty  Int?
  phaseOutLateDays   Int?
  /// Harga satuan saat snapshot dibuat — disimpan supaya nilai historis tidak
  /// ikut berubah ketika harga di OCS berubah besok.
  unitPrice      Int      @default(0)
  computedAt     DateTime @default(now())

  @@id([snapshotDate, areaId, sku])
  @@index([snapshotDate, areaId, status])
  @@index([sku, snapshotDate])
  @@map("doi_snapshot")
}

/// Ringkasan satu perhitungan (KPI + parameter yang dipakai), satu baris per hari.
/// Ringkasan per (tanggal, area). Area khusus `GABUNGAN` menyimpan hasil
/// seluruh kota dijumlahkan — dihitung sekali dan disimpan, bukan dijumlahkan
/// ulang tiap halaman dibuka.
model DoiSummary {
  snapshotDate DateTime @db.Date
  areaId       String   @default("Pusat") @db.VarChar(60)
  computedAt   DateTime @default(now())
  trigger      String   @default("cron") @db.VarChar(20)
  payload      String   @db.Text

  @@id([snapshotDate, areaId])
  @@map("doi_summary")
}

/// Riwayat unggahan berkas.
model UploadBatch {
  id         String   @id @db.VarChar(40)
  kind       String   @db.VarChar(24) // SALES | TRANSIT | LEAD_TIME
  filename   String   @db.VarChar(260)
  rowCount   Int      @default(0)
  mode       String   @default("REPLACE") @db.VarChar(16)
  note       String?  @db.VarChar(300)
  uploadedAt DateTime @default(now())

  @@index([kind, uploadedAt])
  @@map("upload_batch")
}

/// Seluruh pengaturan operasional. Nilai disimpan sebagai teks, di-parse di aplikasi.
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     String   @db.VarChar(500)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_setting")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actor    String   @default("system") @db.VarChar(60)
  action   String   @db.VarChar(60)
  entity   String   @db.VarChar(60)
  entityId String?  @db.VarChar(120)
  detail   String?  @db.Text

  @@index([at])
  @@map("audit_log")
}

model SyncLog {
  id         BigInt    @id @default(autoincrement())
  kind       String    @db.VarChar(16) // STOCK | SALES | COMPUTE | BUNDLE
  trigger    String    @default("cron") @db.VarChar(20)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") @db.VarChar(16) // running | ok | error | skipped
  rows       Int       @default(0)
  message    String?   @db.VarChar(500)

  @@index([kind, startedAt])
  @@map("sync_log")
}

/// Pengguna aplikasi. Password disimpan sebagai hash scrypt (salt:hash).
model AppUser {
  id           String    @id @db.VarChar(40)
  username     String    @unique @db.VarChar(60)
  passwordHash String    @db.VarChar(200)
  name         String    @db.VarChar(120)
  role         String    @default("USER") @db.VarChar(20) // ADMIN | USER | VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@map("app_user")
}

/// Kunci antar-proses supaya cron Vercel dan tombol Refresh tidak menulis bersamaan.
model SyncLock {
  name       String   @id @db.VarChar(30)
  owner      String   @db.VarChar(120)
  acquiredAt DateTime @default(now())

  @@map("sync_lock")
}

/// Harga jual per SKU dari OCS (/Products/GetProductSkus).
/// OCS memberi SalePrice sebagai ARRAY — satu harga per marketplace — jadi
/// ketiganya disimpan: `price` (yang dipakai), plus min & max sebagai jejak.
model ProductPrice {
  sku       String   @id @db.VarChar(120)
  name      String?  @db.VarChar(500)
  /// Harga yang dipakai menghitung nilai stok (bawaan: terendah antar marketplace).
  price     Int      @default(0)
  priceMin  Int      @default(0)
  priceMax  Int      @default(0)
  /// Berapa marketplace yang menyumbang harga — 0 berarti OCS tidak punya harganya.
  sources   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("product_price")
}

// ===========================================================================
// ATP Monitoring (8 Okt 2026). ADITIF — tidak ada model lama yang diubah atau
// di-rename. Jalankan `npm run check:push` sebelum `db:push` untuk membuktikan
// tidak ada tabel yang akan terhapus.
// ===========================================================================

/// Brand (= toko) per SKU.
///
/// Di OCS TIDAK ADA medan bernama "Brand". Yang ada `ShopCode`/`ShopName` di
/// `DTO_LookupStockDetailedData`, isinya Hanasui / NCO / FYNE / EOMMA.
///
/// Diukur 8 Okt 2026 dengan akun JONATHAN: dari 375 SKU aktif kategori Sku,
/// 348 (92,8%) dapat brand. 27 sisanya hampir semuanya berprefiks `CS-`.
/// Yang kosong TIDAK ditebak dari nama (keputusan user) — ditampilkan apa adanya
/// sebagai "brand belum diketahui" dan diisi manual.
///
/// 16 SKU punya DUA brand (semuanya pasangan Hanasui/NCO, mis.
/// BBS-CHEERFUL-BLISS = ItemCode 1201020204). Diselesaikan dengan urutan
/// prioritas tetap Hanasui -> NCO -> FYNE -> EOMMA, supaya hasilnya TIDAK
/// berubah hanya karena urutan baris dari OCS bergeser.
model SkuBrand {
  sku       String   @id @db.VarChar(120)
  /// Brand hasil penyelesaian prioritas. Kosong = belum diketahui.
  brand     String   @default("") @db.VarChar(40)
  /// Semua brand yang OCS sebut untuk SKU ini, dipisah koma — untuk audit.
  brandAsal String   @default("") @db.VarChar(200)
  /// true = diisi orang, bukan dari OCS. Isi manual TIDAK boleh tertimpa sync.
  manual    Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([brand])
  @@map("sku_brand")
}

/// Komposisi bundling — SKU turunan dari sebuah bundle.
///
/// Sumbernya `GET /MasterData/GetBundleStock` di OCS (dibongkar 9 Okt 2026 dari
/// halaman /master/bundle, bukan ditebak). Bentuk responsnya:
///
///   { BundleSku, BundleName, TotalQty, TotalAvailableQty,
///     Stocks: [{ AreaId, AvailableQty }],
///     Items:  [{ SellerSku, SellerSkuQty, TotalAvailableQty,
///                Stocks: [{ AreaId, AvailableQty }] }] }
///
/// Terukur saat dibongkar: 2.029 bundle, 6.040 baris komponen, rata-rata 2,98
/// komponen, PALING BANYAK 14, paling sedikit 1, dan tidak ada satu pun bundle
/// tanpa komponen. `SellerSkuQty` sampai 10. Area yang muncul persis 5 cabang
/// kita. Payload 2,5 MB, 2,4 detik.
///
/// YANG DISIMPAN HANYA KOMPOSISINYA — qty per bundle. `Items[].Stocks` dan
/// `TotalAvailableQty` SENGAJA TIDAK disimpan: stok per SKU per area sudah ada
/// di `stock_current`, yang ditarik tiap Refresh. Menyimpannya dua kali berarti
/// dua angka bernama sama yang bisa berbeda umur, dan yang akan dicurigai user
/// adalah perhitungannya — bukan dua sumbernya. Status aktif komponen juga
/// dibaca dari `stock_current.isActive`, bukan dari sini.
///
/// Komposisi bundling itu master data yang jarang berubah, jadi TIDAK ditarik
/// tiap Refresh (lihat `bundle_refresh_hours`).
model BundleItem {
  /// SKU bundle-nya — sama persis dengan `stock_current.sku` berkategori Bundle.
  bundleSku String   @db.VarChar(120)
  /// SKU komponennya. Bisa Sku maupun Gimmick.
  itemSku   String   @db.VarChar(120)
  /// Berapa pcs komponen ini per satu bundle (`SellerSkuQty`).
  qty       Int      @default(1)
  /// Nama bundle dari OCS — disimpan supaya bundle yang TIDAK ada di
  /// stock_current masih bisa disebut namanya saat dilaporkan.
  name      String   @default("") @db.VarChar(500)
  pulledAt  DateTime @default(now())

  @@id([bundleSku, itemSku])
  @@index([itemSku])
  @@map("bundle_item")
}

/// Sebaran SKU ke cabang — lapisan keputusan MANUSIA, di atas `isActive` OCS.
///
/// KENAPA TABEL INI ADA, dibuktikan 8 Okt 2026: `isActive` dari OCS TIDAK
/// mencatat sebaran. Himpunan SKU aktif di Medan, Makassar, Surabaya, dan
/// Yogyakarta IDENTIK PERSIS (356 SKU yang sama, diuji dengan membandingkan
/// himpunan, bukan jumlah); Pusat punya 19 tambahan. Kalau flag itu memang
/// mencatat sebaran, Medan dan Makassar pasti berbeda. Jadi tidak ada data OCS
/// yang bisa menjawab "produk ini disebar ke cabang itu atau tidak".
///
/// TIGA KEADAAN, dan ketiganya harus bisa dibedakan:
///   baris TIDAK ADA    -> belum diputuskan (bawaan; cabang/SKU baru masuk sini)
///   dibagikan = true   -> memang disebar ke cabang itu  -> IKUT pembagi ATP
///   dibagikan = false  -> sengaja TIDAK disebar         -> KELUAR dari pembagi
///
/// Tidak adanya baris disengaja sebagai bawaan: keputusan user adalah cabang
/// baru TIDAK ada yang tercentang sampai diisi manual, dan "belum diputuskan"
/// harus terhitung sebagai peringatan, bukan diam-diam dianggap tidak disebar.
model AtpShare {
  sku        String   @db.VarChar(120)
  /// NAMA area (bukan kode gudang) — kunci yang sama dengan `stock_current`.
  areaId     String   @db.VarChar(60)
  dibagikan  Boolean
  note       String?  @db.VarChar(300)
  /// Siapa yang memutuskan — supaya keputusan sebaran bisa ditelusuri.
  updatedBy  String   @default("") @db.VarChar(120)
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([sku, areaId])
  @@index([areaId, dibagikan])
  @@map("atp_share")
}

/// Potret ATP harian per area, untuk tren.
///
/// Tabel sendiri, bukan menumpang `stock_daily`: yang disimpan di sini adalah
/// hasil keputusan ATP (pembagi, siap, belum diputuskan) pada ambang dan aturan
/// yang berlaku HARI ITU. Menghitungnya ulang dari `stock_daily` nanti akan
/// memakai ambang yang berlaku SEKARANG, sehingga tren masa lalu berubah setiap
/// kali ambangnya diubah — dan grafiknya jadi bohong tentang masa lalu.
model AtpDaily {
  snapshotDate DateTime @db.Date
  areaId       String   @db.VarChar(60)
  /// Ambang yang dipakai saat potret ini dibuat (pcs). Direkam, bukan diasumsikan.
  ambang       Int      @default(5)
  /// Pembagi: SKU yang dibagikan ke area ini DAN layak masuk ATP.
  dihitung     Int      @default(0)
  /// Dari `dihitung`, yang availableQty > ambang.
  siap         Int      @default(0)
  /// Tidak ikut pembagi: sengaja tidak disebar.
  takDisebar   Int      @default(0)
  /// Tidak ikut pembagi: belum ada keputusannya.
  belumDiputus Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@id([snapshotDate, areaId])
  @@index([areaId, snapshotDate])
  @@map("atp_daily")
}
