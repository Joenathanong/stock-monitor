# ---- Database TiDB Serverless (MySQL 8) ----
# Wajib pakai TLS. Ambil dari TiDB Cloud > Connect > Prisma.
DATABASE_URL="mysql://USER:PASSWORD@gateway01.xxx.prod.aws.tidbcloud.com:4000/doi_monitor?sslaccept=strict"

# ---- Koneksi OCS ----
OCS_BASE_URL=https://ocs.iegsystem.id
# WAJIB — akun menentukan AREA MANA yang terlihat. Akun ber-scope sempit
# membuat penarikan menyusut diam-diam ke satu area tanpa galat.
OCS_USERNAME=
OCS_PASSWORD=
OCS_COMPANY_DB=EJI_WMS

# ---- Login aplikasi (multi-user) ----
# Kunci tanda tangan cookie sesi, minimal 16 karakter acak. Mengganti kunci = semua pengguna keluar.
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Admin pertama dibuat oleh `npm run db:seed` bila tabel pengguna kosong (atau lewat halaman login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Opsional: kunci untuk dashboard TV publik. Kosong = /tv bisa dibuka siapa saja.
# Bila diisi, buka /tv?key=<nilai ini>.
PUBLIC_TV_TOKEN=

# Poster WhatsApp /wa — WAJIB diisi kalau poster dipakai.
# Tanpa ini endpoint-nya menolak (503), bukan terbuka: angka stok & nilai rupiah
# seluruh area tidak boleh publik hanya karena variabel ini lupa diisi.
# Bot membuka:  /wa?k=<token>   atau  /api/public/wa/svg?k=<token>
WA_PAGE_TOKEN=

# ---- Penjadwal ----
# Header Authorization: Bearer <CRON_SECRET> untuk /api/cron/*
CRON_SECRET=ganti-dengan-string-acak-panjang

# ---- Zona waktu ----
APP_TZ_OFFSET_MINUTES=420

# --- Gudang pemasok EJI (web.eji.co.id/sap_whs/stock) untuk Sugest PO ---
# Sumber saldo yang membatasi saran PO. Isi nilainya di .env, JANGAN di repo.
EJI_USERNAME=
EJI_PASSWORD=
# Gudang pemasok, URUT PRIORITAS - yang pertama diperiksa lebih dulu.
# Kosong = GBJD2,GBJD (keputusan user 2 Okt 2026: cek GBJD2 dulu, lalu GBJD).
EJI_WHS=GBJD2,GBJD
# Hanya kalau alur login perlu disesuaikan - nama medan form login bisa berbeda.
EJI_LOGIN_URL=
EJI_FIELD_USER=
EJI_FIELD_PASS=
# Jalan pintas untuk menguji endpoint tanpa alur login (cookie sesi dari browser).
# Kedaluwarsa sendiri; jangan dipakai di produksi.
EJI_COOKIE=
