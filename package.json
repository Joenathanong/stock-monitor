{
  "name": "doi-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "IEG DOI Monitor - perhitungan Days of Inventory otomatis dari OCS (Next.js 15 + Prisma + TiDB Serverless + Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-phase-out": "tsx scripts/reset-phase-out.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "check:db": "tsx scripts/check-db.ts",
    "check:ocs": "tsx scripts/check-ocs.ts",
    "sync:stock": "tsx scripts/sync-stock.ts",
    "sync:sales": "tsx scripts/sync-sales.ts",
    "backfill:sales": "tsx scripts/backfill-sales.ts",
    "compute": "tsx scripts/compute.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
